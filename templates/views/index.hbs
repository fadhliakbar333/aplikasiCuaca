<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Aplikasi Cek Cuaca</title>
    <link rel="icon" href="/img/cuaca.png">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .hero-section { max-width:1100px; margin:28px auto; padding:22px; background:linear-gradient(90deg,#f8fafc,#ffffff); border-radius:12px; box-shadow:0 8px 30px rgba(15,23,36,0.04); }
        .hero-section h1 { margin:0 0 8px; font-size:1.8rem }
        .hero-subtitle { color:#555; margin-bottom:14px }
        .weather-form .input-group { display:flex; gap:8px }
        .weather-form input { flex:1; padding:10px 12px; border-radius:8px; border:1px solid #e6e9ef }
        .weather-form button { padding:10px 14px; background:#667eea; color:#fff; border:none; border-radius:8px; cursor:pointer }
        .features-grid { max-width:1100px; margin:20px auto 60px; display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:18px }
        .feature-card { background:#fff; padding:18px; border-radius:10px; box-shadow:0 6px 18px rgba(2,6,23,0.05); text-align:center }
        .feature-card i { font-size:1.6rem; color:#667eea; margin-bottom:8px }
    </style>
</head>
<body>
    {{> header}}

    <main class="hero-section">
        <h1><i class="fas fa-cloud-sun"></i> Aplikasi Cek Cuaca</h1>
        <p class="hero-subtitle">Dapatkan informasi cuaca terkini untuk lokasi mana pun di dunia</p>

        <div class="weather-form">
            <form>
                <div class="input-group">
                    <input id="search" placeholder="Masukkan nama kota atau lokasi...">
                    <button type="submit"><i class="fas fa-search"></i> Cari Lokasi</button>
                </div>
            </form>
        </div>

        <div class="weather-info">
            <p id="pesan-1"></p>
            <p id="pesan-2"></p>
        </div>
    </main>

    <section class="features-grid">
        <div class="feature-card">
            <i class="fas fa-bolt"></i>
            <h3>Real-time Data</h3>
            <p>Informasi cuaca diperbarui secara real-time dari sumber terpercaya</p>
        </div>
        <div class="feature-card">
            <i class="fas fa-globe-americas"></i>
            <h3>Global Coverage</h3>
            <p>Mendukung pencarian cuaca untuk lokasi di seluruh dunia</p>
        </div>
        <div class="feature-card">
            <i class="fas fa-mobile-alt"></i>
            <h3>Responsive Design</h3>
            <p>Akses mudah dari desktop, tablet, atau smartphone</p>
        </div>
    </section>

    {{> footer}}
    <script src="/js/app.js"></script>
</body>
</html>